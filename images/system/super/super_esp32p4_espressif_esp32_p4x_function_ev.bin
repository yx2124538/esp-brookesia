                        "padding": 0
                    },
                    "children": [
                        {
                            "type": "container",
                            "id": "backdrop",
                            "commonProps": {
                                "clickable": false,
                                "scrollable": false
                            },
                            "placement": {
                                "mode": "absolute",
                                "x": 0,
                                "y": 0,
                                "width": "${env.widthDp}",
                                "height": "${env.heightDp}"
                            },
                            "styleRefs": [
                                "system.appOverlayLaunchBackdrop"
                            ]
                        },
                        {
                            "type": "container",
                            "id": "surface",
                            "commonProps": {
                                "clickable": false,
                                "scrollable": false
                            },
                            "bindings": {
                                "placement.x": "x",
                                "placement.y": "y",
                                "placement.width": "width",
                                "placement.height": "height"
                            },
                            "placement": {
                                "mode": "absolute",
                                "x": 0,
                                "y": 0,
                                "width": "1dp",
                                "height": "1dp"
                            },
                            "styleRefs": [
                                "system.appOverlayLaunchSurface"
                            ]
                        },
                        {
                            "type": "container",
                            "id": "icon_box",
                            "commonProps": {
                                "hidden": true,
                 
␀␀               "clickable": false,
                                "scrollable": false
                            },
                            "bindings": {
                                "commonProps.hidden": "hidden",
                                "placement.x": "x",
