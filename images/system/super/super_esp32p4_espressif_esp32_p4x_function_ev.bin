                                    "gridTemplateRows": [
                                        "match"
                                    ],
                                    "gap": "12dp",
                                    "crossAlign": "center"
                                },
                                "placement": {
                                    "mode": "flow",
                                    "width": "match",
                                    "height": "${constant.settings.layout.smallRowHeight}",
                                    "alignSelf": "stretch"
                                },
