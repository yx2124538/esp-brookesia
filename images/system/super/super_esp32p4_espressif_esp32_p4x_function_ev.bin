    "type": "viewScreen",
    "id": "overlay",
    "commonProps": {
        "clickable": false,
        "scrollable": false
    },
    "placement": {
        "mode": "absolute",
        "x": 0,
        "y": 0,
        "width": "${env.widthDp}",
        "height": "${env.heightDp}"
    },
    "style": {
        "padding": 0
    },
    "children": [
        {
            "type": "container",
            "id": "system_ui_mask",
            "commonProps": {
                "hidden": true,
                "clickable": true,
                "scrollable": false
            },
            "bindings": {
                "commonProps.hidden": "hidden"
            },
            "events": [
                {
                    "type": "clicked",
                    "action": "super.nav.mask.click"
                },
                {
                    "type": "gesture",
                    "action": "super.nav.mask.gesture"
                }
            ],
            "placement": {
                "mode": "absolute",
                "x": 0,
                "y": 0,
                "width": "${env.widthDp}",
                "height": "${env.heightDp}"
            },
            "style": {
                "padding": 0
            }
        },
        {
            "type": "container",
            "id": "status",
            "layout": {
                "type": "flex",
                "flexFlow": "row",
                "gap": "${constant.ui.overlay.metric.statusGap}",
                "mainAlign": "spaceBetween",
                "crossAlign": "center"
            },
            "style": {
                "paddingLeft": "${constant.ui.overlay.metric.statusPaddingX}",
                "paddingRight": "${constant.ui.overlay.metric.statusPaddingX}",
                "paddingTop": "${constant.ui.overlay.metric.statusPaddingY}",
                "paddingBottom": "${constant.ui.overlay.metric.statusPaddingY}"
            },
            "placement": {
                "mode": "absolute",
                "x": 0,
                "y": "${constant.ui.overlay.metric.statusBarExpandedY}",
                "width": "match",
                "height": "${constant.ui.overlay.metric.topBarHeight}"
            },
            "bindings": {
                "placement.y": "system_ui_status_y"
            },
            "children": [
                {
                    "type": "container",
                    "id": "status_right",
                    "layout": {
                        "type": "flex",
                        "flexFlow": "row",
                        "mainAlign": "end",
                        "crossAlign": "center",
                        "gap": "${constant.ui.overlay.metric.statusItemGap}"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "${constant.ui.overlay.metric.statusPillHeight}"
                    },
                    "children": [
