    "type": "viewScreen",
    "id": "wifi_connect",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "templateRef",
                    "id": "network_card",
                    "templateId": "settings_card",
                    "slots": {
                        "content": [
                            {
                                "type": "label",
                                "id": "caption",
                                "styleRefs": [
                                    "app.caption"
                                ],
                                "labelProps": {
                                    "text": "Selected network"
                                },
                                "placement": {
                                    "mode": "flow"
                                },
                                "bindings": {
                                    "labelProps.text": "labelProps.text"
                                }
                            },
                            {
                                "type": "label",
                                "id": "ssid",
                                "styleRefs": [
                                    "app.cardTitle"
                                ],
                                "labelProps": {
                                    "text": "Network"
                                },
                                "placement": {
                                    "mode": "flow"
                                },
                                "bindings": {
                                    "labelProps.text": "ssid"
                                }
                            },
                            {
                                "type": "label",
                                "id": "detail",
                                "styleRefs": [
                                    "app.cardSubtitle"
                                ],
                                "labelProps": {
                                    "text": "Secured"
                                },
                                "placement": {
                                    "mode": "flow"
                                },
                                "bindings": {
                                    "labelProps.text": "detail"
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "templateRef",
                    "id": "password_card",
                    "templateId": "settings_card",
