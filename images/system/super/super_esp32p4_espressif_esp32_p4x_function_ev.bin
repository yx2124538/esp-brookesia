                                "x": 0,
                                "y": 0,
                                "width": "${env.widthDp}",
                                "height": "${env.heightDp}"
                            },
                            "styleRefs": [
                                "system.appOverlayLaunchBackdrop"
                            ]
                        },
                        {
                            "type": "container",
                            "id": "surface",
                            "commonProps": {
                                "clickable": false,
                                "scrollable": false
                            },
                            "bindings": {
                                "placement.x": "x",
                                "placement.y": "y",
                                "placement.width": "width",
                                "placement.height": "height"
                            },
                            "placement": {
                                "mode": "absolute",
                                "x": 0,
                                "y": 0,
                                "width": "1dp",
                                "height": "1dp"
                            },
                            "styleRefs": [
                                "system.appOverlayLaunchSurface"
                            ]
                        },
                        {
                            "type": "container",
                            "id": "icon_box",
                            "commonProps": {
                                "hidden": true,
                 5␀␀               "clickable": false,
                                "scrollable": false
                            },
                            "bindings": {
                                "commonProps.hidden": "hidden",
                                "placement.x": "x",
                                "placement.y": "y",
                                "placement.width": "width",
                                "placement.height": "height"
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "absolute",
                                "x": 0,
                                "y": 0,
                                "width": "1dp",
                                "height": "1dp"
                            },
                            "children": [
                                {
                                    "type": "image",
                                    "id": "icon_image",
                                    "commonProps": {
                                        "clickable": false,
                                        "hidden": true
                                    },
                                    "bindings": {
                                        "imageProps.src": "src",
                                        "commonProps.hidden": "hidden"
                                    },
                                    "imageProps": {
                                        "src": "",
                                        "innerAlign": "contain"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "match",
                                        "height": "match"
                                    }
                                },
                                {
                                    "type": "label",
                                    "id": "fallback_label",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "bindings": {
                                        "labelProps.text": "text",
                                        "commonProps.hidden": "hidden"
                                    },
                                    "labelProps": {
                                        "text": "?"
                                    },
                                    "placement": {
                                        "mode": "flow",
                                        "width": "wrap",
                                        "height": "wrap"
                                    },
                                    "styleRefs": [
